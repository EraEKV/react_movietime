rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    function isOwner(doc) { return signedIn() && doc.ownerUid == uid(); }
    function isMember(doc) { return verified() && email() in doc.memberEmails; }
    function isEditor(doc) { return verified() && doc.roles.get(email(), '') == 'editor'; }
    function isPublic(doc) { return doc.visibility == 'link'; }
    function canRead(doc) { return isOwner(doc) || isMember(doc) || isPublic(doc); }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // A member removes only themselves from roles and memberEmails.
    function isLeaving() {
      let me = [email()].toSet();
      return isMember(resource.data)
        && onlyChanges(['roles', 'memberEmails', 'updatedAt'])
        && request.resource.data.memberEmails.toSet() == resource.data.memberEmails.toSet().difference(me)
        && request.resource.data.roles.keys().toSet() == resource.data.roles.keys().toSet().difference(me);
    }

    // Sharing fields of a list or plan as the owner writes them: roles and memberEmails
    // describe the same people, roles are only editor/viewer, at most 20 members, and the
    // owner can't add their own email (they already have full access).
    function validSharing(d) {
      return d.visibility in ['private', 'link']
        && d.roles is map
        && d.memberEmails is list
        && d.memberEmails.size() <= 20
        && d.roles.keys().toSet() == d.memberEmails.toSet()
        && d.roles.values().hasOnly(['editor', 'viewer'])
        && !(request.auth.token.get('email', '').lower() in d.memberEmails);
    }

    // A library entry as the app writes it. The document id must be "<mediaType>_<tmdbId>",
    // so the same title can't be stored twice under different ids.
    function validLibraryEntry(mediaKey) {
      let d = request.resource.data;
      return d.keys().hasOnly(['mediaType', 'tmdbId', 'title', 'posterPath', 'year', 'genreIds',
          'tmdbRating', 'runtime', 'totalEpisodes', 'status', 'score', 'notes', 'progress',
          'addedAt', 'updatedAt', 'completedAt'])
        && d.mediaType in ['movie', 'tv']
        && d.tmdbId is int
        && mediaKey == d.mediaType + '_' + string(d.tmdbId)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.status in ['plan', 'watching', 'completed', 'dropped']
        && (d.score == null || (d.score is int && d.score >= 1 && d.score <= 10))
        && d.notes is string && d.notes.size() <= 500
        && (d.progress == null || d.progress is map)
        && d.genreIds is list;
    }

    // A list as the app writes it: known fields only, name 1–60, description ≤ 300.
    function validList() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'name', 'description', 'emoji',
          'visibility', 'roles', 'memberEmails', 'itemCount', 'covers', 'createdAt', 'updatedAt'])
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.description is string && d.description.size() <= 300
        && d.emoji is string && d.emoji.size() <= 16
        && validSharing(d)
        && d.itemCount is int && d.itemCount >= 0
        && d.covers is list && d.covers.size() <= 4;
    }

    // A list item: the document id must be "<mediaType>_<tmdbId>" (one item per title).
    function validListItem(mediaKey) {
      let d = request.resource.data;
      return d.keys().hasOnly(['mediaType', 'tmdbId', 'title', 'posterPath', 'year', 'genreIds',
          'tmdbRating', 'note', 'position', 'addedBy', 'addedAt'])
        && d.mediaType in ['movie', 'tv']
        && d.tmdbId is int
        && mediaKey == d.mediaType + '_' + string(d.tmdbId)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.note is string && d.note.size() <= 200
        && d.position is number
        && d.addedBy is map && d.addedBy.uid is string
        && d.genreIds is list;
    }

    // ---------- private user data ----------
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;

      match /library/{mediaKey} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && validLibraryEntry(mediaKey);
      }
      match /activity/{activityId} {
        allow read, create: if signedIn() && uid() == userId;
      }
    }

    // ---------- lists ----------
    match /lists/{listId} {
      // get = open one document by id (a shared link works for anyone). list = queries:
      // only for owners and members, so nobody can enumerate every public list.
      allow get: if canRead(resource.data);
      allow list: if isOwner(resource.data) || isMember(resource.data);
      allow create: if isOwner(request.resource.data) && validList()
        && request.resource.data.itemCount == 0;
      allow update: if (isOwner(resource.data)
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && validList())
                    || (isEditor(resource.data)
                        && onlyChanges(['itemCount', 'covers', 'updatedAt']))
                    || isLeaving();
      allow delete: if isOwner(resource.data);

      match /items/{mediaKey} {
        function list() { return get(/databases/$(database)/documents/lists/$(listId)).data; }
        function canEdit() { return isOwner(list()) || isEditor(list()); }
        allow read: if canRead(list());
        allow create, update: if canEdit() && validListItem(mediaKey);
        allow delete: if canEdit();
      }
    }

    // ---------- plans ----------
    function isDayString(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }

    // The parts of a plan that marking, skipping and rescheduling sessions change.
    function validPlanProgress(d) {
      return d.doneUnits is int && d.doneUnits >= 0 && d.doneUnits <= d.totalUnits
        && (d.nextDate == null || isDayString(d.nextDate))
        && isDayString(d.endDate)
        && d.status in ['active', 'done', 'archived'];
    }

    // A plan as the owner writes it: known fields only, a series plan carries the series
    // snapshot, a list plan the source list id; colour 1–6; and validSharing().
    function validPlan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'ownerName', 'title', 'kind', 'media', 'sourceListId',
          'options', 'color', 'totalUnits', 'doneUnits', 'totalMinutes', 'nextDate', 'endDate',
          'status', 'visibility', 'roles', 'memberEmails', 'createdAt', 'updatedAt'])
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && ((d.kind == 'series' && d.media is map) || (d.kind == 'list' && d.sourceListId is string))
        && d.options is map && d.options.weekdays is list
        && d.options.weekdays.size() >= 1 && d.options.weekdays.size() <= 7
        && d.color is int && d.color >= 1 && d.color <= 6
        && d.totalUnits is int && d.totalUnits >= 1 && d.totalUnits <= 5000
        && d.totalMinutes is int && d.totalMinutes >= 0
        && validPlanProgress(d)
        && validSharing(d);
    }

    // A session: 1–10 episodes (or one movie) on a day at a time.
    function validSession() {
      let d = request.resource.data;
      return d.keys().hasOnly(['index', 'date', 'time', 'units', 'minutes', 'status', 'doneAt',
          'doneBy', 'copyOf'])
        && d.index is int && d.index >= 0
        && isDayString(d.date)
        && d.time is string && d.time.matches('[0-2][0-9]:[0-5][0-9]')
        && d.units is list && d.units.size() >= 1 && d.units.size() <= 10
        && d.minutes is int && d.minutes >= 0
        && d.status in ['pending', 'done', 'skipped']
        && (d.copyOf == null || d.copyOf is string);
    }

    // "Marked by" can only name yourself, or stay as it was (someone else marked it before).
    function validDoneBy(before) {
      let by = request.resource.data.doneBy;
      return by == null
        || (by is map && by.keys().hasOnly(['uid', 'name']) && by.name is string
            && (by.uid == uid() || (before != null && by == before.doneBy)));
    }

    match /plans/{planId} {
      allow get: if canRead(resource.data);
      allow list: if isOwner(resource.data) || isMember(resource.data);
      allow create: if isOwner(request.resource.data) && validPlan()
        && request.resource.data.doneUnits == 0;
      allow update: if (isOwner(resource.data)
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && validPlan())
                    || (isEditor(resource.data)
                        && onlyChanges(['doneUnits', 'nextDate', 'endDate', 'status', 'updatedAt'])
                        && validPlanProgress(request.resource.data))
                    || isLeaving();
      allow delete: if isOwner(resource.data);

      match /sessions/{sessionId} {
        function plan() { return get(/databases/$(database)/documents/plans/$(planId)).data; }
        // getAfter() sees the plan as it will be after the batch: the plan and its first
        // sessions are created in one batch, when get() would still find nothing.
        function planAfter() { return getAfter(/databases/$(database)/documents/plans/$(planId)).data; }
        function canEdit(p) { return isOwner(p) || isEditor(p); }

        allow read: if canRead(plan());
        allow create: if canEdit(planAfter()) && validSession() && validDoneBy(null);
        // Marking, skipping, undoing and moving: what is watched (units, order) stays.
        allow update: if canEdit(planAfter()) && validSession() && validDoneBy(resource.data)
          && request.resource.data.units == resource.data.units
          && request.resource.data.index == resource.data.index;
        // The owner deletes (with the plan); an editor only the copy a skip added (Undo).
        allow delete: if isOwner(plan())
          || (isEditor(plan()) && resource.data.get('copyOf', null) != null);
      }
    }
  }
}
