{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://movietime-c83d7.firebaseapp.com/__/auth/:path*"
    },
    { "source": "/api/tmdb/:path*", "destination": "/api/tmdb?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "refactor/**": false,
      "docs/**": false,
      "test/**": false,
      "ci/**": false,
      "build/**": false,
      "chore/**": false,
      "perf/**": false
    }
  }
}
