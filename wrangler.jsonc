{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-movietime",
  "main": "worker/index.ts",
  // process.env is filled from vars and secrets (needs nodejs_compat and a date from 2025-04).
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any path that is not a file is answered with index.html, so deep links work on refresh.
    "not_found_handling": "single-page-application",
    // The worker sees only these; everything else is static and never runs code.
    "run_worker_first": ["/api/*", "/__/*"],
  },
  "vars": {
    "FIREBASE_AUTH_HOST": "movietime-c83d7.firebaseapp.com",
    // Set SITE_URL (the app's address) and the secrets in the Cloudflare dashboard:
    // TMDB_TOKEN, RESEND_API_KEY, RESEND_FROM, VAPID_PRIVATE_KEY, VAPID_SUBJECT,
    // FIREBASE_SERVICE_ACCOUNT, VITE_FIREBASE_API_KEY, VITE_FIREBASE_PROJECT_ID,
    // VITE_VAPID_PUBLIC_KEY.
  },
}
