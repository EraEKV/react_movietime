{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-movietime",
  "main": "worker/index.ts",
  // process.env is filled from vars and secrets (needs nodejs_compat and a date from 2025-04).
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any path that is not a file is answered with index.html, so deep links work on refresh.
    "not_found_handling": "single-page-application",
    // The worker sees only these; everything else is static and never runs code.
    "run_worker_first": ["/api/*", "/__/*"],
  },
  // Plain settings live here: a deploy replaces any variable set in the dashboard, so the
  // dashboard only holds secrets (TMDB_TOKEN, RESEND_API_KEY, VAPID_PRIVATE_KEY,
  // FIREBASE_SERVICE_ACCOUNT).
  "vars": {
    "FIREBASE_AUTH_HOST": "movietime-c83d7.firebaseapp.com",
    "RESEND_FROM": "Avleron <invites@avleron.com>",
    "SITE_URL": "https://avleron.com",
    "VAPID_SUBJECT": "mailto:invites@avleron.com",
    "VITE_VAPID_PUBLIC_KEY": "BBq_YDAnGdUby1_BZ-a37pWCJHIannFkzyCI8V2u9RdxlWIYFXPcDJl_H095IzyWmczZbxVrE6oV8AhDhXqwf1E",
    // Public web config; the mail and push endpoints check the caller's token with it.
    "VITE_FIREBASE_API_KEY": "AIzaSyBjZM9D2P9ieQT1DfJOZGNCwjriJIWCOIg",
    "VITE_FIREBASE_PROJECT_ID": "movietime-c83d7",
  },
}
